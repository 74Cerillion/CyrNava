{
  "concurrency": {
    "cancel-in-progress": true,
    "group": "cyrnava-ci-${{ github.workflow }}-${{ github.ref }}"
  },
  "defaults": {
    "run": {
      "shell": "bash --noprofile --norc -eo pipefail {0}"
    }
  },
  "env": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "jobs": {
    "backend": {
      "name": "Backend and security",
      "needs": "validate",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1",
          "with": {
            "python-version": "3.12"
          }
        },
        {
          "uses": "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
          "with": {
            "cache": "npm",
            "cache-dependency-path": "frontend/package-lock.json\nfrontend/package.json\n.nvmrc\n",
            "node-version-file": ".nvmrc",
            "package-manager-cache": false
          }
        },
        {
          "name": "Install verification dependencies",
          "run": "sudo apt-get update -qq\nsudo apt-get install -y --no-install-recommends flatpak ostree\npython -m venv backend/.venv\nbackend/.venv/bin/python -m pip install --only-binary=:all: -r backend/requirements.txt\nbackend/.venv/bin/python -m pip install --require-hashes --only-binary=:all: -r ci/requirements.lock\nbackend/.venv/bin/python -m pip check\nnpm install --global npm@11.6.2 --ignore-scripts --no-audit --no-fund\n"
        },
        {
          "name": "Backend, security, lifecycle and migration regressions",
          "run": "python ci/verify.py backend --require-clean-frontend"
        },
        {
          "if": "always()",
          "name": "Preserve synthetic test diagnostics",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "error",
            "name": "backend-diagnostics-${{ github.sha }}-${{ github.run_attempt }}",
            "path": "ci-output/backend*",
            "retention-days": 7
          }
        }
      ],
      "timeout-minutes": 15
    },
    "frontend": {
      "env": {
        "PLAYWRIGHT_JUNIT_OUTPUT_FILE": "${{ github.workspace }}/ci-output/browser-junit.xml"
      },
      "name": "Frontend and browser",
      "needs": "validate",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1",
          "with": {
            "python-version": "3.12"
          }
        },
        {
          "uses": "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
          "with": {
            "cache": "npm",
            "cache-dependency-path": "frontend/package-lock.json\nfrontend/package.json\n.nvmrc\n",
            "node-version-file": ".nvmrc",
            "package-manager-cache": false
          }
        },
        {
          "name": "Install locked frontend and browser dependencies",
          "run": "python -m venv backend/.venv\nbackend/.venv/bin/python -m pip install --only-binary=:all: -r backend/requirements.txt\nbackend/.venv/bin/python -m pip check\nnpm install --global npm@11.6.2 --ignore-scripts --no-audit --no-fund\nnpm --prefix frontend ci --ignore-scripts --no-audit --no-fund\ncd frontend\nnpx --no-install playwright install --with-deps chromium\n"
        },
        {
          "name": "Lint, unit tests, TypeScript, production build and Chromium tests",
          "run": "python ci/verify.py frontend"
        },
        {
          "if": "always()",
          "name": "Preserve synthetic browser diagnostics",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "error",
            "name": "frontend-diagnostics-${{ github.sha }}-${{ github.run_attempt }}",
            "path": "ci-output/frontend.json\nci-output/browser-junit.xml\nfrontend/test-results/\n",
            "retention-days": 7
          }
        }
      ],
      "timeout-minutes": 20
    },
    "native": {
      "name": "Native Ubuntu source installation and update",
      "needs": [
        "backend",
        "frontend"
      ],
      "runs-on": "ubuntu-26.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "fetch-depth": 0,
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38",
          "with": {
            "cache": "npm",
            "cache-dependency-path": "frontend/package-lock.json\nfrontend/package.json\n.nvmrc\n",
            "node-version-file": ".nvmrc",
            "package-manager-cache": false
          }
        },
        {
          "env": {
            "EXPECTED_SOURCE": "${{ github.sha }}"
          },
          "name": "Verify immutable source and install native source prerequisites",
          "run": "test \"$(git rev-parse HEAD)\" = \"$EXPECTED_SOURCE\"\ntest -z \"$(git status --porcelain)\"\nsudo apt-get update -qq\nsudo apt-get install -y --no-install-recommends python3.14-venv build-essential desktop-file-utils apparmor libglib2.0-bin libnss3 libnspr4 libasound2t64 libegl1 libopengl0 libxkbcommon-x11-0 libxcb-cursor0 libxcomposite1 libxdamage1 libxrandr2 libxtst6 libfontconfig1\nnpm install --global npm@11.6.2 --ignore-scripts --no-audit --no-fund\n"
        },
        {
          "name": "Native installer, security and transaction regressions",
          "run": "/usr/bin/python3.14 -B -m unittest discover -s packaging/native -p 'test_*.py' -v\n/usr/bin/python3.14 -B -m unittest discover -s packaging/native/feasibility -p 'test_*.py' -v\n"
        },
        {
          "name": "Verify clean no-Git source installation and data-preserving online update",
          "run": "/usr/bin/python3.14 -B ci/native_source.py --output ci-output/native-source"
        },
        {
          "if": "always()",
          "name": "Preserve safe source-install diagnostics without binary payloads",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "if-no-files-found": "error",
            "name": "source-install-diagnostics-${{ github.sha }}-${{ github.run_attempt }}",
            "path": "ci-output/native-source/artifacts/*.json",
            "retention-days": 7
          }
        }
      ],
      "timeout-minutes": 30
    },
    "required": {
      "env": {
        "BACKEND_RESULT": "${{ needs.backend.result }}",
        "FRONTEND_RESULT": "${{ needs.frontend.result }}",
        "NATIVE_RESULT": "${{ needs.native.result }}",
        "VALIDATE_RESULT": "${{ needs.validate.result }}"
      },
      "if": "always()",
      "name": "CI required",
      "needs": [
        "validate",
        "backend",
        "frontend",
        "native"
      ],
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "name": "Require every verification and artifact job to succeed",
          "run": "for result in \"$VALIDATE_RESULT\" \"$BACKEND_RESULT\" \"$FRONTEND_RESULT\" \"$NATIVE_RESULT\"; do\n  test \"$result\" = success || exit 1\ndone\n"
        }
      ],
      "timeout-minutes": 2
    },
    "validate": {
      "name": "Workflow validation",
      "runs-on": "ubuntu-24.04",
      "steps": [
        {
          "uses": "actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "uses": "actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1",
          "with": {
            "python-version": "3.12"
          }
        },
        {
          "name": "Install locked workflow parser",
          "run": "python -m pip install --require-hashes --only-binary=:all: -r ci/requirements.lock\n"
        },
        {
          "name": "Validate workflow and negative contracts",
          "run": "python ci/validate.py\npython -m unittest discover -s ci -p 'test_ci.py' -v\npython ci/bootstrap.py \"$RUNNER_TEMP/ci-tools\"\n\"$RUNNER_TEMP/ci-tools/actionlint\" -color .github/workflows/ci.yml\n"
        }
      ],
      "timeout-minutes": 10
    }
  },
  "name": "CyrNava CI",
  "on": {
    "pull_request": {
      "branches": [
        "main"
      ]
    },
    "push": {
      "branches": [
        "desktop/p2-production-integration",
        "main"
      ]
    },
    "workflow_dispatch": null
  },
  "permissions": {
    "contents": "read"
  }
}
