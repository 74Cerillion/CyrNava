# Dependency environments and generated files
node_modules/
.venv/
dist/
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.tsbuildinfo
# Never commit local notes, captures, credentials, or databases.
data/
notes/
uploads/
assets/
# Only this application-owned startup script belongs in the local asset bundle.
!frontend/public/assets/
frontend/public/assets/*
!frontend/public/assets/appearance-init.js
captures/
*.pcap
*.pcapng
*.db
*.sqlite*
.env
.env.*
*.pem
*.key
*.log
.DS_Store

# M5 sensitive backup/recovery data and generated browser reports
backups/
*.engage-backup/
.engage-stage-*/
engage-conflict-*.json
engage-draft-*.json
playwright-report/
test-results/
.engage.lock
