# Dependency environments and generated files
node_modules/
.venv/
dist/
coverage/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.tsbuildinfo
# Never commit local notes, captures, credentials, or databases.
data/
notes/
uploads/
assets/
# Explicit application-owned assets only; user uploads remain excluded.
!frontend/public/assets/
frontend/public/assets/*
!frontend/public/assets/appearance-init.js
!frontend/public/assets/branding/
frontend/public/assets/branding/*
!frontend/public/assets/branding/DesktopLogo.png
!frontend/public/assets/branding/cyrnava-16.png
!frontend/public/assets/branding/cyrnava-32.png
!frontend/public/assets/branding/cyrnava-48.png
!frontend/public/assets/branding/cyrnava-64.png
!frontend/public/assets/branding/cyrnava-128.png
!frontend/public/assets/branding/cyrnava-256.png
!frontend/public/assets/branding/cyrnava-512.png
captures/
*.pcap
*.pcapng
*.db
*.sqlite*
.env
.env.*
*.pem
*.key
*.log
.DS_Store

# M5 sensitive backup/recovery data and generated browser reports
backups/
*.engage-backup/
.engage-stage-*/
engage-conflict-*.json
engage-draft-*.json
cyrnava-conflict-*.json
cyrnava-draft-*.json
.venv-before-cyrnava-*/
playwright-report/
test-results/
.engage.lock

# Local P4 build outputs; never packaged or committed.
.p4-cache/

# P5A generated CI diagnostics and local tool/download caches
ci-output/

# P5B disposable repositories and signing material; public trust anchors are
# generated into staging outputs, never copied from a personal GnuPG profile.
.p5b-stage/
.p5b-private/
**/private-keys-v1.d/
**/openpgp-revocs.d/
**/pubring.kbx
**/trustdb.gpg
**/secring.gpg

